<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only Phase 0 probe. NOT the launcher: normal debug builds launch
             MainActivity. Reach the probe via:
             adb shell am start -n com.zouhu.speedlimit/.probe.ProbeActivity -->
        <activity
            android:name="com.zouhu.speedlimit.probe.ProbeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name="com.zouhu.speedlimit.diag.HorizonDiagActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name="com.zouhu.speedlimit.diag.NavDiagActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.probe.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/probe_file_paths" />
        </provider>
    </application>

</manifest>